# Frontend (Vite) environment variables.
# Copy to .env for local development: `cp .env.example .env`
# In production (e.g. Netlify), set these in the host's build environment
# instead of committing them — Vite inlines VITE_* values at build time.

# API Configuration
# Local dev points at the local backend. In production set this in Netlify to
# your deployed backend, e.g. https://your-backend-host/api/v1 (no trailing slash).
VITE_API_URL=http://localhost:5001/api/v1

# App Configuration
VITE_APP_NAME=Country Explorer
VITE_APP_VERSION=1.0.0

# Feature Flags
VITE_ENABLE_AUTH=true
VITE_ENABLE_FAVORITES=true
