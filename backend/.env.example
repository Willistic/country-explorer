# Server Configuration
NODE_ENV=development
PORT=5001

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/country-explorer

# Frontend Configuration
# Exact origin(s) allowed by CORS. Use your deployed site URL in production
# (no trailing slash), e.g. https://your-site.netlify.app. Comma-separate to
# allow multiple origins (e.g. production + a Netlify preview URL).
FRONTEND_URL=https://theworldismijn.netlify.app/

# Authentication Configuration
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE=7d

# External Countries API
COUNTRIES_API_URL=https://api.restcountries.com/countries/v5
RESTCOUNTRIES_API_KEY=

# Demo user seed (used by create-demo-user.js)
DEMO_USER_EMAIL=demo@example.com
# Optional: omit to auto-generate a strong password on seed
DEMO_USER_PASSWORD=
